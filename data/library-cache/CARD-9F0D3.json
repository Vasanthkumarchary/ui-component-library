{"desc": "This Card was posted by Alexander-Cidbal. Tagged with: card, dark, colorful, neon, digital, circuit, wires.", "image": "/data/library-cache/files/3fb8eebd3bfa1cbf76b9.jpg", "tailwind": false, "html": "<div\n  class=\"card\"\n  style=\"--seed:; \n--Density_Cables: 10;\n--Density_Components: 10;\"\n>\n  <svg class=\"pcb-svg\" viewBox=\"0 0 190 254\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n      <filter id=\"cable-shadow\" x=\"-40%\" y=\"-40%\" width=\"180%\" height=\"180%\">\n        <fedropshadow\n          dx=\"3.5\"\n          dy=\"6.5\"\n          stdDeviation=\"4\"\n          flood-color=\"#000000\"\n          flood-opacity=\"0.9\"\n        ></fedropshadow>\n      </filter>\n\n      <filter id=\"chip-shadow\" x=\"-25%\" y=\"-25%\" width=\"150%\" height=\"150%\">\n        <fedropshadow\n          dx=\"2\"\n          dy=\"4\"\n          stdDeviation=\"2.5\"\n          flood-color=\"#000000\"\n          flood-opacity=\"0.95\"\n        ></fedropshadow>\n      </filter>\n\n      <pattern id=\"pcb-grid\" width=\"8\" height=\"8\" patternUnits=\"userSpaceOnUse\">\n        <circle cx=\"4\" cy=\"4\" r=\"0.7\" fill=\"#1b4731\" opacity=\"0.65\"></circle>\n      </pattern>\n\n      <linearGradient id=\"metal\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n        <stop offset=\"0%\" stop-color=\"#555\"></stop>\n        <stop offset=\"50%\" stop-color=\"#fff\"></stop>\n        <stop offset=\"100%\" stop-color=\"#444\"></stop>\n      </linearGradient>\n\n      <linearGradient id=\"gold-pin\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n        <stop offset=\"0%\" stop-color=\"#e5c158\"></stop>\n        <stop offset=\"100%\" stop-color=\"#997a23\"></stop>\n      </linearGradient>\n\n      <linearGradient id=\"chip-grad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n        <stop offset=\"0%\" stop-color=\"#2a2e35\"></stop>\n        <stop offset=\"100%\" stop-color=\"#0e1012\"></stop>\n      </linearGradient>\n\n      <linearGradient id=\"heatsink\" x1=\"0%\"