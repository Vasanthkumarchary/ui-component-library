"></circle>\n        <circle cx=\"110\" cy=\"20\" r=\"2\"></circle>\n        <circle cx=\"140\" cy=\"10\" r=\"2\"></circle>\n        <circle cx=\"30\" cy=\"40\" r=\"2\"></circle>\n        <circle cx=\"160\" cy=\"10\" r=\"2\"></circle>\n        <circle cx=\"150\" cy=\"100\" r=\"2\"></circle>\n        <circle cx=\"10\" cy=\"100\" r=\"2\"></circle>\n        <circle cx=\"70\" cy=\"240\" r=\"2\"></circle>\n        <circle cx=\"120\" cy=\"240\" r=\"2\"></circle>\n        <circle cx=\"20\" cy=\"140\" r=\"2\"></circle>\n        <circle cx=\"170\" cy=\"80\" r=\"2\"></circle>\n        <circle cx=\"50\" cy=\"150\" r=\"2\"></circle>\n      </g>\n    </g>\n\n    <g class=\"seed-chips\" filter=\"url(#chip-shadow)\">\n      <g class=\"comp-lvl-1\">\n        <path\n          d=\"M 65 75 h -8 M 65 85 h -8 M 65 95 h -8 M 65 105 h -8 M 125 75 h 8 M 125 85 h 8 M 125 95 h 8 M 125 105 h 8\"\n          stroke=\"url(#metal)\"\n          stroke-width=\"2.2\"\n        ></path>\n        <rect\n          x=\"65\"\n          y=\"68\"\n          width=\"60\"\n          height=\"46\"\n          rx=\"3\"\n          fill=\"url(#chip-grad)\"\n          stroke=\"#3a3f47\"\n          stroke-width=\"1\"\n        ></rect>\n        <circle cx=\"73\" cy=\"76\" r=\"2\" fill=\"#555\"></circle>\n        <text\n          x=\"95\"\n          y=\"93\"\n          font-family=\"monospace\"\n          font-size=\"7\"\n          fill=\"#888\"\n          text-anchor=\"middle\"\n          letter-spacing=\"1\"\n        >\n          XOTLA\n        </text>\n      </g>\n\n      <g class=\"comp-lvl-2\">\n        <path\n          d=\"M 25 160 v -5 M 32 160 v -5 M 39 160 v -5\"\n          stroke=\"url(#metal)\"\n          stroke-width=\"2\"\n        ></path>\n        <rect\n          x=\"20\"\n          y=\"160\"\n          width=\"24\"\n          height=\"16\"\n          rx=\"2\"\n          fill=\"url(#chip-grad)\"\n          stroke=\"#3a3f47\"\n          stroke-width=\"0.8\"\n        ></rect>\n        <text\n          x=\"32\"\n          y=\"171\"\n          font-family=\"monospace\"\n          font-size=\"5\"\n          fill=\"#777\"\n          text-anchor=\"middle\"\n        >\n          vReg\n        </text>\n        <circle\n          cx=\"150\"\n          cy=\"70\"\n          r=\"8\"\n          fill=\"#1e2228\"\n          stroke=\"#444\"\n          stroke-width=\"1\"\n        ></circle>\n        <circle cx=\"150\" cy=\"70\" r=\"6\" fill=\"#2c313a\"></circle>\n      </g>\n\n      <g class=\"comp-lvl-3\">\n        <path\n          d=\"M 25 210 h -6 M 25 220 h -6 M 25 230 h -6 M 25 240 h -6 M 65 210 h 6 M 65 220 h 6 M 65 230 h 6 M 65 240 h 6\"\n          stroke=\"url(#metal)\"\n          stroke-width=\"2\"\n        ></path>\n        <rect\n          x=\"25\"\n          y=\"205\"\n          width=\"40\"\n          height=\"40\"\n          rx=\"2\"\n          fill=\"url(#chip-grad)\"\n          stroke=\"#3a3f47\"\n          stroke-width=\"1\"\n        ></rect>\n        <text\n          x=\"45\"\n          y=\"227\"\n          font-family=\"monospace\"\n          font-size=\"6\"\n          fill=\"#888\"\n          text-anchor=\"middle\"\n        >\n          Audio\n        </text>\n      </g>\n\n      <g class=\"comp-lvl-4\">\n        <circle\n          cx=\"155\"\n          cy=\"180\"\n          r=\"11\"\n          fill=\"#1e2228\"\n          stroke=\"#444\"\n          stroke-width=\"1\"\n        ></circle>\n        <circle cx=\"155\" cy=\"180\" r=\"8.5\" fill=\"#2c313a\"></circle>\n        <path d=\"M 148 180 h 14\" stroke=\"#d4af37\" stroke-width=\"1.5\"></path>\n        <circle\n          cx=\"35\"\n          cy=\"35\"\n          r=\"9\"\n          fill=\"#1e2228\"\n          stroke=\"#444\"\n          stroke-width=\"1\"\n        ></circle>\n        <circle cx=\"35\" cy=\"35\" r=\"7\" fill=\"#2c313a\"></circle>\n      </g>\n\n      <g class=\"comp-lvl-5\">\n        <rect\n          x=\"10\"\n          y=\"110\"\n          width=\"8\"\n          height=\"45\"\n          rx=\"1\"\n          fill=\"#222\"\n          stroke=\"#444\"\n          stroke-width=\"1\"\n        ></rect>\n        <path\n          d=\"M 14 114 v 5 M 14 123 v 5 M 14 132 v 5 M 14 141 v 5 M 14 150 v 5\"\n          stroke=\"url(#gold-pin)\"\n          stroke-width=\"2\"\n        ></path>\n      </g>\n\n      <g class=\"comp-lvl-6\">\n        <rect\n          x=\"140\"\n          y=\"25\"\n          width=\"22\"\n          height=\"12\"\n          rx=\"4\"\n          fill=\"url(#metal)\"\n          stroke=\"#222\"\n          stroke-width=\"0.8\"\n        ></rect>\n        <text\n          x=\"151\"\n          y=\"33\"\n          font-family=\"monospace\"\n          font-size=\"5\"\n          fill=\"#333\"\n          text-anchor=\"middle\"\n        >\n          16.0MHz\n        </text>\n        <rect x=\"70\" y=\"20\" width=\"6\" height=\"3\" fill=\"#000\"></rect>\n        <rect x=\"80\" y=\"20\" width=\"6\" height=\"3\" fill=\"#000\"></rect>\n        <rect x=\"90\" y=\"20\" width=\"6\" height=\"3\" fill=\"#000\"></rect>\n      </g>\n\n      <g class=\"comp-lvl-7\">\n        <rect\n          x=\"125\"\n          y=\"115\"\n          width=\"35\"\n          height=\"35\"\n          rx=\"2\"\n          fill=\"url(#chip-grad)\"\n          stroke=\"#3a3f47\"\n          stroke-width=\"1\"\n        ></rect>\n        <circle cx=\"131\" cy=\"121\" r=\"1.5\" fill=\"#666\"></circle>\n        <text\n          x=\"142\"\n          y=\"134\"\n          font-family=\"monospace\"\n          font-size=\"5.5\"\n          fill=\"#777\"\n          text-anchor=\"middle\"\n        >\n          RZK\n        </text>\n      </g>\n\n      <g class=\"comp-lvl-8\">\n        <g fill=\"#1a1a1a\" stroke=\"#d4af37\" stroke-width=\"0.6\">\n          <rect x=\"75\" y=\"130\" width=\"10\" height=\"5\"></rect>\n          <rect x=\"75\" y=\"138\" width=\"10\" height=\"5\"></rect>\n          <rect x=\"75\" y=\"146\" width=\"10\" height=\"5\"></rect>\n          <rect x=\"90\" y=\"130\" width=\"10\" height=\"5\"></rect>\n          <rect x=\"90\" y=\"138\" width=\"10\" height=\"5\"></rect>\n          <rect x=\"90\" y=\"146\" width=\"10\" height=\"5\"></rect>\n        </g>\n      </g>\n\n      <g class=\"comp-lvl-9\">\n        <rect\n          x=\"80\"\n          y=\"180\"\n          width=\"40\"\n          height=\"30\"\n          rx=\"1\"\n          fill=\"url(#heatsink)\"\n          stroke=\"#111\"\n          stroke-width=\"1\"\n        ></rect>\n      </g>\n\n      <g class=\"comp-lvl-10\">\n        <rect\n          x=\"10\"\n          y=\"240\"\n          width=\"55\"\n          height=\"10\"\n          rx=\"1\"\n          fill=\"#151515\"\n          stroke=\"#00ff88\"\n          stroke-width=\"0.8\"\n        ></rect>\n        <path\n          d=\"M 15 240 v 10 M 20 240 v 10 M 25 240 v 10 M 30 240 v 10 M 35 240 v 10 M 40 240 v 10 M 45 240 v 10 M 50 240 v 10 M 55 240 v 10\"\n          stroke=\"url(#gold-pin)\"\n          stroke-width=\"1\"\n        ></path>\n      </g>\n    </g>\n\n    <g filter=\"url(#cable-shadow)\" fill=\"none\" stroke-linecap=\"round\">\n      <g class=\"seed-cable-group-1 cable-lvl-1\">\n        <path\n          d=\"M -10 40 C 40 10, 110 80, 200 30\"\n          stroke=\"#e63946\"\n          stroke-width=\"6\"\n        ></path>\n        <path\n          d=\"M -10 40 C 40 10, 110 80, 200 30\"\n          stroke=\"#ff758f\"\n          stroke-width=\"2\"\n          opacity=\"0.85\"\n        ></path>\n      </g>\n\n      <g class=\"seed-cable-group-2 cable-lvl-2\">\n        <path\n          d=\"M 20 264 C 10 180, 160 200, 130 110 C 110 40, 170 -10, 170 -10\"\n          stroke=\"#1d3557\"\n          stroke-width=\"7\"\n        ></path>\n        <path\n          d=\"M 20 264 C 10 180, 160 200, 130 110 C 110 40, 170 -10, 170 -10\"\n          stroke=\"#457b9d\"\n          stroke-width=\"5\"\n        ></path>\n        <path\n          d=\"M 20 264 C 10 180, 160 200, 130 110 C 110 40, 170 -10, 170 -10\"\n          stroke=\"#a8dadc\"\n          stroke-width=\"1.5\"\n          opacity=\"0.8\"\n        ></path>\n      </g>\n\n      <g class=\"seed-cable-group-3 cable-lvl-3\">\n        <path\n          d=\"M -10 140 C 60 110, 80 230, 200 160\"\n          stroke=\"#ffb703\"\n          stroke-width=\"5\"\n        ></path>\n        <path\n          d=\"M -10 140 C 60 110, 80 230, 200 160\"\n          stroke=\"#fff3b0\"\n          stroke-width=\"1.5\"\n          opacity=\"0.9\"\n        ></path>\n      </g>\n\n      <g class=\"seed-cable-group-4 cable-lvl-4\">\n        <path\n          d=\"M 50 -10 C 100 90, 10 130, 80 264\"\n          stroke=\"#111115\"\n          stroke-width=\"6.5\"\n        ></path>\n        <path\n          d=\"M 50 -10 C 100 90, 10 130, 80 264\"\n          stroke=\"#44444e\"\n          stroke-width=\"2\"\n          opacity=\"0.75\"\n        ></path>\n      </g>\n\n      <g class=\"seed-cable-group-5 cable-lvl-5\">\n        <path\n          d=\"M 180 264 C 120 190, 170 120, 10 -10\"\n          stroke=\"#38b000\"\n          stroke-width=\"5\"\n        ></path>\n        <path\n          d=\"M 180 264 C 120 190, 170 120, 10 -10\"\n          stroke=\"#ccff33\"\n          stroke-width=\"1.5\"\n          opacity=\"0.85\"\n        ></path>\n      </g>\n\n      <g class=\"seed-cable-group-6 cable-lvl-6\">\n        <path\n          d=\"M -10 80 C 50 120, 120 40, 200 70\"\n          stroke=\"#8338ec\"\n          stroke-width=\"5.5\"\n        ></path>\n        <path\n          d=\"M -10 80 C 50 120, 120 40, 200 70\"\n          stroke=\"#c77dff\"\n          stroke-width=\"1.8\"\n          opacity=\"0.8\"\n        ></path>\n      </g>\n\n      <g class=\"seed-cable-group-7 cable-lvl-7\">\n        <path\n          d=\"M 40 264 C 30 160, 140 180, 100 90 C 80 20, 140 -10, 140 -10\"\n          stroke=\"#fb5607\"\n          stroke-width=\"6\"\n        ></path>\n        <path\n          d=\"M 40 264 C 30 160, 140 180, 100 90 C 80 20, 140 -10, 140 -10\"\n          stroke=\"#ffbe0b\"\n          stroke-width=\"1.8\"\n          opacity=\"0.9\"\n        ></path>\n      </g>\n\n      <g class=\"seed-cable-group-8 cable-lvl-8\">\n        <path\n          d=\"M -10 190 C 60 160, 110 240, 200 200\"\n          stroke=\"#00b4d8\"\n          stroke-width=\"5\"\n        ></path>\n        <path\n          d=\"M -10 190 C 60 160, 110 240, 200 200\"\n          stroke=\"#90e0ef\"\n          stroke-width=\"1.5\"\n          opacity=\"0.85\"\n        ></path>\n      </g>\n\n      <g class=\"seed-cable-group-9 cable-lvl-9\">\n        <path\n          d=\"M -10 210 C 70 180, 80 100, 200 120\"\n          stroke=\"#7209b7\"\n          stroke-width=\"5.5\"\n        ></path>\n        <path\n          d=\"M -10 210 C 70 180, 80 100, 200 120\"\n          stroke=\"#f72585\"\n          stroke-width=\"2\"\n          opacity=\"0.85\"\n        ></path>\n      </g>\n\n      <g class=\"seed-cable-group-10 cable-lvl-10\">\n        <path\n          d=\"M 190 10 C 130 90, 40 170, -10 240\"\n          stroke=\"#f15bb5\"\n          stroke-width=\"6\"\n        ></path>\n        <path\n          d=\"M 190 10 C 130 90, 40 170, -10 240\"\n          stroke=\"#fee440\"\n          stroke-width=\"2\"\n          opacity=\"0.9\"\n        ></path>\n        <path\n          d=\"M -10 100 C 90 20, 100 220, 200 250\"\n          stroke=\"#00f5d4\"\n          stroke-width=\"5\"\n        ></path>\n        <path\n          d=\"M -10 100 C 90 20, 100 220, 200 250\"\n          stroke=\"#ffffff\"\n          stroke-width=\"1.5\"\n          opacity=\"0.95\"\n        ></path>\n      </g>\n    </g>\n  </svg>\n</div>\n", "css": ".card {\n  /* Variables de control por defecto (Límite máximo ampliado a 10) */\n  --seed: 1;\n  --Density_Cables: 10; /* Rango: 1 (Escaso) a 10 (Saturación extrema) */\n  --Density_Components: 10; /* Rango: 1 (Escaso) a 10 (Saturación extrema) */\n\n  width: 100%;\n  max-width: 380px;\n  aspect-ratio: 190 / 254;\n\n  background: #07140e;\n  border-radius: 12px;\n  position: relative;\n  overflow: hidden;\n  box-shadow:\n    0 12px 24px -6px rgba(0, 0, 0, 0.7),\n    0 0 0 1px rgba(255, 255, 255, 0.1) inset;\n  transition:\n    transform 0.3s ease,\n    box-shadow 0.3s ease;\n  margin: 0 auto;\n}\n\n.pcb-svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n/* ============================================================\n   CONTROL DE DENSIDAD DE 1 A 10 (CABLES Y COMPONENTES)\n   ============================================================ */\n\n/* Evaluación de visibilidad en 10 niveles para Cables */\n.cable-lvl-1 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 0), 1);\n}\n.cable-lvl-2 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 1), 1);\n}\n.cable-lvl-3 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 2), 1);\n}\n.cable-lvl-4 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 3), 1);\n}\n.cable-lvl-5 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 4), 1);\n}\n.cable-lvl-6 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 5), 1);\n}\n.cable-lvl-7 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 6), 1);\n}\n.cable-lvl-8 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 7), 1);\n}\n.cable-lvl-9 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 8), 1);\n}\n.cable-lvl-10 {\n  opacity: clamp(0, calc(var(--Density_Cables) - 9), 1);\n}\n\n/* Evaluación de visibilidad en 10 niveles para Componentes PCB */\n.comp-lvl-1 {\n  opacity: clamp(0, calc(var(--Density_Components) - 0), 1);\n}\n.comp-lvl-2 {\n  opacity: clamp(0, calc(var(--Density_Components) - 1), 1);\n}\n.comp-lvl-3 {\n  opacity: clamp(0, calc(var(--Density_Components) - 2), 1);\n}\n.comp-lvl-4 {\n  opacity: clamp(0, calc(var(--Density_Components) - 3), 1);\n}\n.comp-lvl-5 {\n  opacity: clamp(0, calc(var(--Density_Components) - 4), 1);\n}\n.comp-lvl-6 {\n  opacity: clamp(0, calc(var(--Density_Components) - 5), 1);\n}\n.comp-lvl-7 {\n  opacity: clamp(0, calc(var(--Density_Components) - 6), 1);\n}\n.comp-lvl-8 {\n  opacity: clamp(0, calc(var(--Density_Components) - 7), 1);\n}\n.comp-lvl-9 {\n  opacity: clamp(0, calc(var(--Density_Components) - 8), 1);\n}\n.comp-lvl-10 {\n  opacity: clamp(0, calc(var(--Density_Components) - 9), 1);\n}\n\n/* ============================================================\n   LÓGICA MATEMÁTICA PSEUDOALEATORIA POR SEED (10 GRUPOS)\n   ============================================================ */\n\n.seed-traces,\n.seed-chips,\n.seed-cable-group-1,\n.seed-cable-group-2,\n.seed-cable-group-3,\n.seed-cable-group-4,\n.seed-cable-group-5,\n.seed-cable-group-6,\n.seed-cable-group-7,\n.seed-cable-group-8,\n.seed-cable-group-9,\n.seed-cable-group-10 {\n  transform-origin: 95px 127px;\n}\n\n.seed-traces {\n  transform: scaleX(calc(1 - 2 * mod(var(--seed), 2)))\n    rotate(calc(mod(var(--seed) * 3, 4) * 90deg));\n  filter: hue-rotate(calc(var(--seed) * 45deg));\n}\n\n.seed-chips {\n  transform: translate(\n      calc(sin(var(--seed) * 1.5) * 10px),\n      calc(cos(var(--seed) * 2.2) * 14px)\n    )\n    rotate(calc(mod(var(--seed), 2) * 180deg));\n}\n\n/* Transformaciones matemáticamente desacopladas para cada cable */\n.seed-cable-group-1 {\n  transform: rotate(calc(sin(var(--seed) * 1.1) * 180deg))\n    translate(\n      calc(cos(var(--seed) * 2.1) * 12px),\n      calc(sin(var(--seed) * 3.4) * 12px)\n    );\n  filter: hue-rotate(calc(var(--seed) * 137.5deg));\n}\n\n.seed-cable-group-2 {\n  transform: scaleX(calc(1 - 2 * mod(var(--seed), 2)))\n    rotate(calc(cos(var(--seed) * 0.9) * 90deg))\n    translate(\n      calc(sin(var(--seed) * 1.7) * 15px),\n      calc(cos(var(--seed) * 2.5) * 15px)\n    );\n  filter: hue-rotate(calc(var(--seed) * -85deg));\n}\n\n.seed-cable-group-3 {\n  transform: scaleY(calc(1 - 2 * mod(var(--seed) + 1, 2)))\n    rotate(calc(sin(var(--seed) * 3.1) * 120deg))\n    translate(\n      calc(cos(var(--seed) * 4.2) * 10px),\n      calc(sin(var(--seed) * 1.1) * 10px)\n    );\n  filter: hue-rotate(calc(var(--seed) * 210deg));\n}\n\n.seed-cable-group-4 {\n  transform: rotate(calc(cos(var(--seed) * 1.8) * 360deg))\n    scale(calc(0.9 + cos(var(--seed) * 0.5) * 0.2));\n  filter: hue-rotate(calc(var(--seed) * -160deg));\n}\n\n.seed-cable-group-5 {\n  transform: rotate(calc(sin(var(--seed) * 2.7) * -150deg))\n    translate(\n      calc(sin(var(--seed) * 0.5) * 18px),\n      calc(cos(var(--seed) * 1.2) * 18px)\n    );\n  filter: hue-rotate(calc(var(--seed) * 95deg));\n}\n\n.seed-cable-group-6 {\n  transform: scaleX(calc(1 - 2 * mod(var(--seed) + 3, 2)))\n    rotate(calc(cos(var(--seed) * 1.4) * 180deg));\n  filter: hue-rotate(calc(var(--seed) * -45deg));\n}\n\n.seed-cable-group-7 {\n  transform: rotate(calc(sin(var(--seed) * 0.6) * 270deg))\n    translate(\n      calc(cos(var(--seed) * 3.1) * 14px),\n      calc(sin(var(--seed) * 2.2) * 14px)\n    );\n  filter: hue-rotate(calc(var(--seed) * 175deg));\n}\n\n.seed-cable-group-8 {\n  transform: scaleY(calc(1 - 2 * mod(var(--seed), 2)))\n    rotate(calc(cos(var(--seed) * 2.1) * 90deg));\n  filter: hue-rotate(calc(var(--seed) * -120deg));\n}\n\n.seed-cable-group-9 {\n  transform: rotate(calc(sin(var(--seed) * 3.8) * 360deg))\n    translate(\n      calc(sin(var(--seed) * 1.9) * 16px),\n      calc(cos(var(--seed) * 0.7) * 16px)\n    );\n  filter: hue-rotate(calc(var(--seed) * 300deg));\n}\n\n.seed-cable-group-10 {\n  transform: scale(calc(0.85 + sin(var(--seed) * 1.3) * 0.25))\n    rotate(calc(cos(var(--seed) * 4.1) * -180deg));\n  filter: hue-rotate(calc(var(--seed) * -230deg));\n}\n\n/* ============================================================ */\n\n/* Efecto de cristal */\n.card::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: linear-gradient(\n    125deg,\n    rgba(255, 255, 255, 0.12) 0%,\n    rgba(255, 255, 255, 0.03) 40%,\n    transparent 40.1%\n  );\n  pointer-events: none;\n}\n\n/* Elevación 3D */\n.card:hover {\n  transform: translateY(-4px) scale(1.02);\n  box-shadow:\n    0 18px 32px -8px rgba(0, 0, 0, 0.8),\n    0 0 14px rgba(0, 255, 136, 0.3),\n    0 0 0 1px rgba(0, 255, 136, 0.4) inset;\n}\n", "license": "mit"}