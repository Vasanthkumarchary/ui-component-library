{"desc": "This Loader was posted by Javierrocadev. Tagged with: blue, loader, rounded, bounce animation, tailwind, animated, loader, simple, blue, minimal, dots, waiting.", "image": "/data/library-cache/files/763bb9617350bfecb275.jpg", "tailwind": true, "html": "<div class=\"flex flex-row gap-2\">\n  <div class=\"w-4 h-4 rounded-full bg-blue-700 animate-bounce\"></div>\n  <div class=\"w-4 h-4 rounded-full bg-blue-700 animate-bounce [animation-delay:-.3s]\"></div>\n  <div class=\"w-4 h-4 rounded-full bg-blue-700 animate-bounce [animation-delay:-.5s]\"></div>\n</div>", "css": ".flex{display:flex}.h-4{height:1rem}.w-4{width:1rem}@keyframes bounce{0%, 100%{transform:translateY(-25%);animation-timing-function:cubic-bezier(0.8,0,1,1)}50%{transform:none;animation-timing-function:cubic-bezier(0,0,0.2,1)}}.animate-bounce{animation:bounce 1s infinite}.flex-row{flex-direction:row}.gap-2{gap:0.5rem}.rounded-full{border-radius:9999px}.bg-blue-700{--tw-bg-opacity:1;background-color:rgb(29 78 216 / var(--tw-bg-opacity))}.\\[animation-delay\\:-\\.3s\\]{animation-delay:-.3s}.\\[animation-delay\\:-\\.5s\\]{animation-delay:-.5s}", "license": "mit"}