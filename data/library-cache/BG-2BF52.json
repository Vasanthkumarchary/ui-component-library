{"desc": "This Pattern was posted by chase2k25. Tagged with: pattern.", "tailwind": false, "html": "<div class=\"futuristic-pattern\">\n  <span class=\"ripple-overlay\"></span>\n  <svg class=\"texture-filter\">\n    <filter id=\"advanced-texture\">\n      <feTurbulence\n        result=\"noise\"\n        numOctaves=\"3\"\n        baseFrequency=\"0.7\"\n        type=\"fractalNoise\"\n      ></feTurbulence>\n      <feSpecularLighting\n        result=\"specular\"\n        lighting-color=\"#fff\"\n        specularExponent=\"20\"\n        specularConstant=\"0.8\"\n        surfaceScale=\"2\"\n        in=\"noise\"\n      >\n        <fePointLight z=\"100\" y=\"50\" x=\"50\"></fePointLight>\n      </feSpecularLighting>\n      <feComposite\n        result=\"litNoise\"\n        operator=\"in\"\n        in2=\"SourceGraphic\"\n        in=\"specular\"\n      ></feComposite>\n      <feBlend mode=\"overlay\" in2=\"litNoise\" in=\"SourceGraphic\"></feBlend>\n    </filter>\n  </svg>\n</div>\n", "css": ".futuristic-pattern {\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(\n    145deg,\n    rgba(59, 43, 124, 0.9),\n    rgba(106, 76, 169, 0.9),\n    rgba(155, 108, 214, 0.9)\n  );\n  filter: url(#advanced-texture);\n}\n", "license": "mit"}