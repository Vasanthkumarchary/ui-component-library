{"desc": "This Card was posted by narmesh_sah. Tagged with: loading, button, card, loader, dark, gradient, colorful, geometric, pentagon, stones, unique card, infinity stones, colorful button.", "image": "/data/library-cache/files/8d8ff97ac30ff31c3c0d.jpg", "tailwind": false, "html": "<div class=\"card\">\n  <div class=\"stones-container\">\n    <div class=\"stone-wrapper\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        viewBox=\"0 0 100 100\"\n        class=\"stone\"\n      >\n        <defs>\n          <radialGradient r=\"50%\" cy=\"50%\" cx=\"50%\" id=\"spaceGlow\">\n            <stop style=\"stop-color:#82adf8\" offset=\"0%\"></stop>\n            <stop style=\"stop-color:#4488ff\" offset=\"20%\"></stop>\n            <stop style=\"stop-color:#1144aa\" offset=\"100%\"></stop>\n          </radialGradient>\n        </defs>\n        <path\n          fill=\"url(#spaceGlow)\"\n          d=\"M30,20 L70,10 L90,40 L80,80 L40,90 L10,60 Z\"\n          class=\"glow\"\n          stroke=\"#4488ff\"\n        ></path>\n      </svg>\n      <div style=\"color: #4488ff\" class=\"stone-name\">Space Stone</div>\n    </div>\n\n    <div class=\"stone-wrapper\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        viewBox=\"0 0 100 100\"\n        class=\"stone\"\n      >\n        <defs>\n          <radialGradient r=\"50%\" cy=\"50%\" cx=\"50%\" id=\"mindGlow\">\n            <stop style=\"stop-color:#f9e89b\" offset=\"0%\"></stop>\n            <stop style=\"stop-color:#ffdd44\" offset=\"20%\"></stop>\n            <stop style=\"stop-color:#aa8800\" offset=\"100%\"></stop>\n          </radialGradient>\n        </defs>\n        <path\n          fill=\"url(#mindGlow)\"\n          d=\"M20,30 L60,10 L90,50 L70,90 L30,80 L10,40 Z\"\n          class=\"glow\"\n          stroke=\"#ffdd44\"\n        ></path>\n      </svg>\n      <div style=\"color: #ffdd44\" class=\"stone-name\">Mind Stone</div>\n    </div>\n\n    <div class=\"stone-wrapper\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        viewBox=\"0 0 100 100\"\n        class=\"stone\"\n      >\n        <defs>\n          <radialGradient r=\"50%\" cy=\"50%\" cx=\"50%\" id=\"realityGlow\">\n            <stop style=\"stop-color:#fc7070\" offset=\"0%\"></stop>\n            <stop style=\"stop-color:#ff4444\" offset=\"20%\"></stop>\n            <stop style=\"stop-color:#aa1111\" offset=\"100%\"></stop>\n          </radialGradient>\n        </defs>\n        <path\n          fill=\"url(#realityGlow)\"\n          d=\"M40,10 L80,30 L90,70 L60,90 L20,80 L10,40 Z\"\n          class=\"glow\"\n          stroke=\"#ff4444\"\n        ></path>\n      </svg>\n      <div style=\"color: #ff4444\" class=\"stone-name\">Reality Stone</div>\n    </div>\n\n    <div class=\"stone-wrapper\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        viewBox=\"0 0 100 100\"\n        class=\"stone\"\n      >\n        <defs>\n          <radialGradient r=\"50%\" cy=\"50%\" cx=\"50%\" id=\"powerGlow\">\n            <stop style=\"stop-color:#bd76f7\" offset=\"0%\"></stop>\n            <stop style=\"stop-color:#aa44ff\" offset=\"20%\"></stop>\n            <stop style=\"stop-color:#6611aa\" offset=\"100%\"></stop>\n          </radialGradient>\n        </defs>\n        <path\n          fill=\"url(#powerGlow)\"\n          d=\"M30,20 L70,10 L90,50 L70,90 L30,80 L10,30 Z\"\n          class=\"glow\"\n          stroke=\"#aa44ff\"\n        ></path>\n      </svg>\n      <div style=\"color: #aa44ff\" class=\"stone-name\">Power Stone</div>\n    </div>\n\n    <div class=\"stone-wrapper\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        viewBox=\"0 0 100 100\"\n        class=\"stone\"\n      >\n        <defs>\n          <radialGradient r=\"50%\" cy=\"50%\" cx=\"50%\" id=\"timeGlow\">\n            <stop style=\"stop-color:#9df89d\" offset=\"0%\"></stop>\n            <stop style=\"stop-color:#44ff44\" offset=\"20%\"></stop>\n            <stop style=\"stop-color:#11aa11\" offset=\"100%\"></stop>\n          </radialGradient>\n        </defs>\n        <path\n          fill=\"url(#timeGlow)\"\n          d=\"M20,20 L60,10 L90,40 L80,80 L40,90 L10,50 Z\"\n          class=\"glow\"\n          stroke=\"#44ff44\"\n        ></path>\n      </svg>\n      <div style=\"color: #44ff44\" class=\"stone-name\">Time Stone</div>\n    </div>\n\n    <div class=\"stone-wrapper\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        viewBox=\"0 0 100 100\"\n        class=\"stone\"\n      >\n        <defs>\n          <radialGradient r=\"50%\" cy=\"50%\" cx=\"50%\" id=\"soulGlow\">\n            <stop style=\"stop-color:#f5c58a\" offset=\"0%\"></stop>\n            <stop style=\"stop-color:#ffaa44\" offset=\"20%\"></stop>\n            <stop style=\"stop-color:#aa6611\" offset=\"100%\"></stop>\n          </radialGradient>\n        </defs>\n        <path\n          fill=\"url(#soulGlow)\"\n          d=\"M30,10 L70,20 L90,50 L70,80 L30,90 L10,40 Z\"\n          class=\"glow\"\n          stroke=\"#ddaa44\"\n        ></path>\n      </svg>\n      <div style=\"color: #ffaa44\" class=\"stone-name\">Soul Stone</div>\n    </div>\n  </div>\n</div>\n", "css": ".card {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  font-family: \"Arial\", sans-serif;\n  overflow: hidden;\n}\n\n.stones-container {\n  position: relative;\n  width: 100%;\n  display: flex;\n  justify-content: space-around;\n  align-items: center;\n  padding: 2rem;\n}\n\n.stone-wrapper {\n  position: relative;\n  width: 120px;\n  height: 120px;\n}\n\n.stone {\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  cursor: pointer;\n  transition: transform 0.3s ease;\n}\n\n.stone:hover {\n  transform: scale(1.2);\n}\n\n.stone-name {\n  position: absolute;\n  width: 100%;\n  text-align: center;\n  bottom: -40px;\n  left: 0;\n  margin-top: 10px;\n  color: #fff;\n  font-size: 16px;\n  font-weight: bold;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  opacity: 0;\n  transition: opacity 0.3s ease;\n  text-shadow: 0 0 10px currentColor;\n}\n\n.stone:hover + .stone-name {\n  opacity: 1;\n}\n\n@keyframes float {\n  0%,\n  100% {\n    transform: translateY(0);\n  }\n  50% {\n    transform: translateY(-10px);\n  }\n}\n\n.stone-wrapper {\n  animation: float 4s ease-in-out infinite;\n}\n\n.stone-wrapper:nth-child(2) {\n  animation-delay: -0.5s;\n}\n.stone-wrapper:nth-child(3) {\n  animation-delay: -1s;\n}\n.stone-wrapper:nth-child(4) {\n  animation-delay: -1.5s;\n}\n.stone-wrapper:nth-child(5) {\n  animation-delay: -2s;\n}\n.stone-wrapper:nth-child(6) {\n  animation-delay: -2.5s;\n}\n", "license": "mit"}