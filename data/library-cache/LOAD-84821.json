{"desc": "This Loader was posted by yohohopizza. Tagged with: blue, loader, rounded, bounce animation, tailwind, dark, animated, loader, red, minimal, loading, dots, waiting.", "image": "/data/library-cache/files/240582e2aa8f6be3d7ab.jpg", "tailwind": true, "html": "<div class=\"flex flex-row gap-2\">\n  <div class=\"w-4 h-4 rounded-full bg-red-500 animate-bounce\"></div>\n  <div\n    class=\"w-4 h-4 rounded-full bg-red-500 animate-bounce [animation-delay:-.3s]\"\n  ></div>\n  <div\n    class=\"w-4 h-4 rounded-full bg-red-500 animate-bounce [animation-delay:-.5s]\"\n  ></div>\n</div>\n", "css": ".flex{display:flex}.h-4{height:1rem}.w-4{width:1rem}@keyframes bounce{0%, 100%{transform:translateY(-25%);animation-timing-function:cubic-bezier(0.8,0,1,1)}50%{transform:none;animation-timing-function:cubic-bezier(0,0,0.2,1)}}.animate-bounce{animation:bounce 1s infinite}.flex-row{flex-direction:row}.gap-2{gap:0.5rem}.rounded-full{border-radius:9999px}.bg-red-500{--tw-bg-opacity:1;background-color:rgb(239 68 68 / var(--tw-bg-opacity))}.\\[animation-delay\\:-\\.3s\\]{animation-delay:-.3s}.\\[animation-delay\\:-\\.5s\\]{animation-delay:-.5s}", "license": "mit"}