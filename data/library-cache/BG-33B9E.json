{"desc": "This Pattern was posted by hans_5258. Tagged with: pattern, black, white, abstract, pattern, camouflage.", "image": "/data/library-cache/files/d29151f5ccec528dd243.jpg", "tailwind": false, "html": "<div class=\"cracked-earth\"></div>\n\n<svg width=\"0\" height=\"0\">\n  <filter id=\"cracks\">\n    <feTurbulence\n      type=\"fractalNoise\"\n      baseFrequency=\"0.02\"\n      numOctaves=\"5\"\n      seed=\"10\"\n      result=\"noise\"\n    ></feTurbulence>\n\n    <feColorMatrix\n      type=\"luminanceToAlpha\"\n      in=\"noise\"\n      result=\"alphaNoise\"\n    ></feColorMatrix>\n\n    <feComponentTransfer in=\"alphaNoise\" result=\"plates\">\n      <feFuncA type=\"discrete\" tableValues=\"0 1\"></feFuncA>\n    </feComponentTransfer>\n\n    <feConvolveMatrix\n      order=\"3 3\"\n      kernelMatrix=\"-1 -1 -1\n        -1  3 -1\n        -1 -1 -1\"\n      in=\"plates\"\n      result=\"edges\"\n    ></feConvolveMatrix>\n\n    <feComponentTransfer in=\"edges\" result=\"invertedEdges\">\n      <feFuncR type=\"table\" tableValues=\"1 0\"></feFuncR>\n      <feFuncG type=\"table\" tableValues=\"1 0\"></feFuncG>\n      <feFuncB type=\"table\" tableValues=\"1 0\"></feFuncB>\n    </feComponentTransfer>\n\n    <feFlood flood-color=\"#000\" result=\"bgColor\"></feFlood>\n    <feComposite operator=\"in\" in=\"bgColor\" in2=\"invertedEdges\"></feComposite>\n  </filter>\n</svg>\n", "css": ".cracked-earth {\n  width: 100%;\n  height: 100%;\n  background-color: #191919;\n  filter: url(#cracks);\n}\n", "license": "mit"}