{"desc": "This Pattern was posted by AatreyuShau. Tagged with: pattern, beige, diamond, soft, subtle, grid, patterned, textured.", "image": "/data/library-cache/files/914dedef8b201687bb2e.jpg", "tailwind": false, "html": "<div class=\"container\"></div>\n<div class=\"paper\">\n  <span class=\"orbit-overlay\"></span>\n  <svg class=\"texture-filter\">\n    <filter id=\"void-texture\">\n      <feTurbulence\n        seed=\"5\"\n        result=\"noise1\"\n        numOctaves=\"8\"\n        baseFrequency=\"0.015\"\n        type=\"fractalNoise\"\n      ></feTurbulence>\n      <feTurbulence\n        seed=\"2\"\n        result=\"noise2\"\n        numOctaves=\"8\"\n        baseFrequency=\"0.015\"\n        type=\"fractalNoise\"\n      ></feTurbulence>\n      <feMerge result=\"noise\">\n        <feMergeNode in=\"noise1\"></feMergeNode>\n        <feMergeNode in=\"noise1\"></feMergeNode>\n        <feMergeNode in=\"noise2\"></feMergeNode>\n      </feMerge>\n      <feGaussianBlur\n        result=\"blur\"\n        stdDeviation=\"0\"\n        in=\"noise\"\n      ></feGaussianBlur>\n      <feSpecularLighting\n        result=\"specular\"\n        lighting-color=\"#ffffff\"\n        specularExponent=\"20\"\n        specularConstant=\"1\"\n        surfaceScale=\"3\"\n        in=\"blur\"\n      >\n        <feDistantLight elevation=\"45\" azimuth=\"90\"></feDistantLight>\n      </feSpecularLighting>\n      <feComposite\n        result=\"lit\"\n        operator=\"over\"\n        in2=\"SourceGraphic\"\n        in=\"specular\"\n      ></feComposite>\n      <feBlend mode=\"screen\" in2=\"lit\" in=\"SourceGraphic\"></feBlend>\n    </filter>\n\n    <filter id=\"alt-void-texture\">\n      <feTurbulence\n        repeatCount=\"indefinite\"\n        dur=\"6s\"\n        values=\"0.015; 0.02; 0.015\"\n        attributeName=\"baseFrequency\"\n        seed=\"2\"\n        result=\"noise1\"\n        numOctaves=\"8\"\n        baseFrequency=\"0.015\"\n        type=\"fractalNoise\"\n      ></feTurbulence>\n      &gt;\n      <feTurbulence\n        repeatCount=\"indefinite\"\n        dur=\"6s\"\n        values=\"0.015; 0.02; 0.015\"\n        attributeName=\"baseFrequency\"\n        seed=\"1\"\n        result=\"noise2\"\n        numOctaves=\"8\"\n        baseFrequency=\"0.015\"\n        type=\"fractalNoise\"\n      ></feTurbulence>\n      &gt;\n      <feMerge result=\"noise\">\n        <feMergeNode in=\"noise1\"></feMergeNode>\n        <feMergeNode in=\"noise1\"></feMergeNode>\n        <feMergeNode in=\"noise2\"></feMergeNode>\n      </feMerge>\n      <feGaussianBlur\n        result=\"blur\"\n        stdDeviation=\"0\"\n        in=\"noise\"\n      ></feGaussianBlur>\n      <feSpecularLighting\n        result=\"specular\"\n        lighting-color=\"#ffeeff\"\n        specularExponent=\"20\"\n        specularConstant=\"1\"\n        surfaceScale=\"3\"\n        in=\"blur\"\n      >\n        <feDistantLight elevation=\"45\" azimuth=\"90\"></feDistantLight>\n      </feSpecularLighting>\n      <feComposite\n        result=\"lit\"\n        operator=\"over\"\n        in2=\"SourceGraphic\"\n        in=\"specular\"\n      ></feComposite>\n      <feBlend mode=\"screen\" in2=\"lit\" in=\"SourceGraphic\"></feBlend>\n    </filter>\n  </svg>\n</div>\n", "css": ".container {\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(circle, #777777 2px, transparent 2px),\n    radial-gradient(circle, #eaeaea 10px, transparent 32px),\n    linear-gradient(\n      -45deg,\n      #eaeaea 0%,\n      transparent 49%,\n      transparent 50%,\n      transparent 51%,\n      #eaeaea 100%\n    ),\n    linear-gradient(\n      45deg,\n      #eaeaea 0%,\n      transparent 49%,\n      #777777 50%,\n      transparent 51%,\n      #eaeaea 100%\n    ),\n    linear-gradient(-45deg, transparent 49%, #777777 50%, transparent 51%);\n  background-size: 8rem 8rem;\n  background-repeat: repeat;\n}\n\n.paper {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  filter: url(#void-texture);\n  background: linear-gradient(\n    to bottom,\n    rgba(194, 167, 87, 0.241) 0%,\n    rgba(162, 125, 55, 0.255) 100%\n  );\n\n  background-size: cover;\n}\n", "license": "mit"}