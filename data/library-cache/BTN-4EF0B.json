y_check {\n  animation: showCheckmark 1s ease-in-out forwards;\n  animation-delay: 3s;\n  width: 500px;\n  opacity: 0;\n}\n\n.pay-btn:focus #fingerprint-container .checkmark,\n.primary_check {\n  opacity: 0;\n}\n\n@keyframes draw {\n  to {\n    stroke-dashoffset: 0;\n    display: none;\n  }\n}\n\n@keyframes showCheckmark {\n  to {\n    opacity: 1;\n  }\n}\n", "license": "mit"}